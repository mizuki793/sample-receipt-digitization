# このファイルをコピーして .env を作成してください
# 値は開発用のダミー値または空にしてください。機密値は公開しないでください。

# LLM / モデル
GEMINI_API_KEY=""
# OPENAI_API_KEY=""
LLM_MODEL_NAME="gemini/gemini-2.5-flash"

# データベース / ストレージ
MONGO_URL="mongodb://root:example@mongodb:27017"
DUCKDB_PATH="/app/data/ocr_few_shots.duckdb"
LOCAL_DATA_SET_BASE_DIR="/app/data"
STORAGE_TYPE="LOCAL"

# サービス URL（コンテナ名に合わせているため通常編集不要）
BACKEND_URL="http://search-rag-service:8001/v1"
RECEIPT_API_URL="http://receipt_fastapi_web:8000/api/v1/receipt"

# LangChain / Provider
LANGCHAIN_MODEL_NAME="gemini-2.5-flash"
LANGCHAIN_MODEL_PROVIDER="google_genai"

# S3 を使う場合のサンプル（コメント解除して値を設定）
# AWS_S3_BUCKET_NAME=""
# AWS_S3_PREFIX=""
# AWS_REGION=""
